# Self-host defaults for the mobile app (public values only — safe to commit).
# Loaded by app.config.ts *after* the repo-root .env and the shell, so anything
# set there wins. Read at Metro bundle time; a change needs a rebuild.
EXPO_PUBLIC_API_URL=https://superset-api.tom-nguyen.dev
EXPO_PUBLIC_WEB_URL=https://superset-app.tom-nguyen.dev
EXPO_PUBLIC_RELAY_URL=https://superset-relay.tom-nguyen.dev
# lib/posthog/client.ts disables the client when the key is this placeholder.
EXPO_PUBLIC_POSTHOG_KEY=phc_unused_selfhosted
EXPO_PUBLIC_SENTRY_ENVIRONMENT=selfhost
