# Self-host settings for the mobile app. Copy to selfhost.env (gitignored) and
# fill in. app.config.ts and scripts/testflight.sh load it; the shell and the
# repo-root .env take precedence. In CI the same names come from repository
# secrets (.github/workflows/testflight-mobile.yml). Read at Metro bundle
# time; a change needs a rebuild.
EXPO_PUBLIC_API_URL=https://api.superset.example.com
EXPO_PUBLIC_WEB_URL=https://app.superset.example.com
EXPO_PUBLIC_RELAY_URL=https://relay.superset.example.com
# lib/posthog/client.ts disables the client when the key is this placeholder.
EXPO_PUBLIC_POSTHOG_KEY=phc_unused_selfhosted
EXPO_PUBLIC_SENTRY_ENVIRONMENT=selfhost
# Bundle identifier (iOS) / package name (Android), and the Apple team that
# signs it — an App ID your own team can sign for, not upstream's.
MOBILE_APP_ID=com.example.superset
APPLE_TEAM_ID=ABCDE12345
