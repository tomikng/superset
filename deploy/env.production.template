#   EXPO_PUBLIC_API_URL, EXPO_PUBLIC_RELAY_URL, EXPO_PUBLIC_POSTHOG_KEY,
#   EXPO_PUBLIC_SENTRY_DSN_MOBILE, EXPO_PUBLIC_SENTRY_ENVIRONMENT
# SKIP_ENV_VALIDATION: do not set it in production.

# --- Seeding-only, NEVER leave set ------------------------------------------
# packages/auth/src/server.ts: disableSignUp = SUPERSET_ALLOW_SIGNUP !== "true".
# This is the entire invitation-only model. Pass it inline for the one seed run
# and never put it in this file:
#   NODE_ENV=development SUPERSET_ALLOW_SIGNUP=true SEED_TEAMS_CONFIRM=yes bun run db:seed-teams
# (NODE_ENV=development is what keeps the personal-org fallback from calling
#  Stripe — see section 2.1. The seed script prints each generated password
