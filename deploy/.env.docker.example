# =============================================================================
# .env.docker — read by docker-compose.prod.yml ONLY (via --env-file).
# This is NOT the application env. The apps read the monorepo-root .env.
#
#   cp .env.docker.example .env.docker
#   chmod 600 .env.docker
#   # then fill in real generated values
#
# Do not commit .env.docker.
# =============================================================================

# --- Postgres credentials -----------------------------------------------------
# Generate:  openssl rand -hex 32
# Keep the password hex/alphanumeric. It is interpolated into
# PG_CONNECTION_STRING (compose) and into DATABASE_URL / DATABASE_URL_UNPOOLED
# (app env) as a URL userinfo component, where reserved characters such as
# @ : / ? # would otherwise need percent-encoding.
POSTGRES_USER=superset
POSTGRES_PASSWORD=REPLACE_ME_openssl_rand_hex_32
POSTGRES_DB=main

# --- SRH bearer token ---------------------------------------------------------
# Generate:  openssl rand -hex 32
# MUST be byte-identical to KV_REST_API_TOKEN in the app's root .env.
SRH_TOKEN=REPLACE_ME_openssl_rand_hex_32

# --- Host-side published ports (loopback only) --------------------------------
# These four names are the ones the repo's docker-compose.yml already uses, and
# smoke-test.sh sources this file to pick them up.
# Verified by grep: they are consumed only by the compose file and by
# .superset/setup.local.sh — no application code reads them.
LOCAL_PG_PORT=5432
LOCAL_NEON_PROXY_PORT=4444
LOCAL_REDIS_PORT=6379
LOCAL_SRH_PORT=8079

# =============================================================================
# Corresponding values for the APPLICATION env (monorepo-root .env) — put these
# THERE, not here. Listed for cross-reference only.
#
#   DATABASE_URL=postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db.localtest.me:4444/main
#   DATABASE_URL_UNPOOLED=postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:5432/main
#   KV_REST_API_URL=http://127.0.0.1:8079
#   KV_REST_API_TOKEN=<SRH_TOKEN>          # byte-identical to SRH_TOKEN above
#   KV_URL=redis://127.0.0.1:6379
#
# Use 127.0.0.1, never localhost, in all four: docker-compose.prod.yml publishes
# these ports on 127.0.0.1 (IPv4) only, and macOS resolves localhost to ::1
# first, where nothing is listening.
#
# The db.localtest.me hostname in DATABASE_URL is load-bearing:
# packages/db/src/local-proxy.ts only routes through neon-proxy when the
# hostname matches exactly. The port in that URL is the proxy's HOST port.
# =============================================================================
