<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  dev.tom-nguyen.superset.relay  ->  superset-relay.tom-nguyen.dev  ->  127.0.0.1:3102

  Start command is apps/relay/package.json "start":  bun run src/index.ts
  (the "dev" script is the one that passes --env-file=../../.env; "start" does
  NOT, which is exactly why the wrapper below sources the .env itself).

  Port: apps/relay/src/env.ts declares RELAY_PORT with .default(3102), and
  apps/relay/src/index.ts serves on { port: env.RELAY_PORT, hostname: "::" }.
  apps/relay/fly.toml pins RELAY_PORT="3102" the same way.

  apps/relay/src/env.ts requires NEXT_PUBLIC_API_URL (the api hostname); the
  relay speaks tunnel v2 with an in-memory host registry and no longer reads
  KV_REST_API_URL / KV_REST_API_TOKEN, so it does not wait for
  serverless-redis-http any more (apps/relay/README.md).
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.tom-nguyen.superset.relay</string>

	<key>WorkingDirectory</key>
	<string>__SUPERSET_ROOT__/apps/relay</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>set -a; . __SUPERSET_ROOT__/.env; set +a; unset SUPERSET_ALLOW_SIGNUP; : "${RELAY_PORT:=3102}"; export RELAY_PORT; exec __BUN_BIN__ run start</string>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>__BUN_DIR__:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>NODE_ENV</key>
		<string>production</string>
		<!-- Fly-era label. apps/relay/src/env.ts defaults it to "local"; set here
		     so /health and /_whoowns identify this box. -->
		<key>FLY_REGION</key>
		<string>ms1</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>20</integer>

	<!-- apps/relay/src/index.ts installs SIGINT and SIGTERM handlers that close
	     the listener and every host control socket (1001) so host-services
	     reconnect within seconds instead of waiting on their 75s watchdog after
	     a TCP RST. launchd's default ExitTimeOut is 20s, raised to 30 so the
	     drain is never cut short by SIGKILL. -->
	<key>ExitTimeOut</key>
	<integer>30</integer>

	<key>ProcessType</key>
	<string>Interactive</string>

	<!-- The relay is the WebSocket terminator for every host-service tunnel.
	     fly.toml sets an http_service soft connection limit of 2000, so 256 fds
	     (the launchd agent default) is nowhere near enough. -->
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>16384</integer>
	</dict>
	<key>HardResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>32768</integer>
	</dict>

	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/superset/relay.out.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/superset/relay.err.log</string>
</dict>
</plist>
